# Leave all of these unset to run the site on demo data only.

# URL of the BirdBrains API (see backend/README.md). Setting it turns on real sign-in and uploads.
NEXT_PUBLIC_API_URL=

# Firebase web app config (Firebase console > Project settings > Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Local development only, with a backend started with BIRDBRAINS_AUTH=dev:
# any email signs in and no password is checked. Never set on a deployed site.
# NEXT_PUBLIC_AUTH_MODE=dev

# Aero brand stage. "ascent-internal" previews the Ascent (ascent.ca) identity for the tutoring network
# in the ecosystem switcher. Leave unset in production: it stays Swift Skills (swiftskills.ca) until cutover.
# NEXT_PUBLIC_BRAND_STAGE=ascent-internal

# Local previews only: point the ecosystem switcher at the other apps on this machine.
# NEXT_PUBLIC_AERO_URL_AERO=http://localhost:4100
# NEXT_PUBLIC_AERO_URL_ASCENT=http://localhost:4101
# NEXT_PUBLIC_AERO_URL_BIRDBRAINS=http://localhost:4102
# NEXT_PUBLIC_AERO_URL_CHIRP=http://localhost:4103
